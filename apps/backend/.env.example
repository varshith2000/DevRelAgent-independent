# ================================================================
# CLICKHOUSE CONFIGURATION
# ================================================================
# For local development with Docker Compose:
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=logs

# For ClickHouse Cloud, uncomment and use these:
# CLICKHOUSE_HOST=xxxxxxx.xxxxx.clickhouse.cloud
# CLICKHOUSE_PORT=8443
# CLICKHOUSE_USERNAME=default
# CLICKHOUSE_PASSWORD=<your-password>
# CLICKHOUSE_DATABASE=logs

# ================================================================
# GRAFANA CONFIGURATION
# ================================================================
# Grafana URL (default for local Docker setup)
GRAFANA_URL=http://localhost:3000

# Grafana API Token - Create at: http://localhost:3000/keys
# 1. Go to Configuration → API Keys
# 2. Click "Add API key"
# 3. Name: "DevRelAgent"
# 4. Role: "Admin" or "Editor"
# 5. Copy the generated token
GRAFANA_API_TOKEN=your_grafana_api_token_here

# Default datasource name in Grafana
GRAFANA_DEFAULT_DATASOURCE=ClickHouse

# ================================================================
# OPENTELEMETRY COLLECTOR CONFIGURATION
# ================================================================
# OTel Collector endpoint (default for local Docker setup)
OTEL_ENDPOINT=localhost:4317
OTEL_PROTOCOL=grpc
# Alternative: use HTTP
# OTEL_ENDPOINT=localhost:4318
# OTEL_PROTOCOL=http

# ================================================================
# SERVER CONFIGURATION
# ================================================================
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# ================================================================
# HEALTH CHECK SCHEDULER
# ================================================================
# Enable/disable proactive health checks
HEALTH_CHECK_ENABLED=true
# Health check interval in minutes
HEALTH_CHECK_INTERVAL_MINUTES=5
# Error rate threshold for alerts (%)
ERROR_SPIKE_THRESHOLD=5.0

# ================================================================
# BROWSER TOOL
# ================================================================
# Comma-separated list of allowed URLs for browser automation
ALLOWED_URLS=localhost,127.0.0.1,grafana.example.com

# ================================================================
# GITHUB INTEGRATION
# ================================================================
# GitHub personal access token for creating issues/PRs
# Create at: https://github.com/settings/tokens
# Required scopes: repo, repo:status, read:org
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# ================================================================
# APPROVAL SYSTEM
# ================================================================
# Approval timeout in seconds (default: 5 minutes)
APPROVAL_TIMEOUT_SECONDS=300


# ================================================================
# LLM CONFIGURATION
# ================================================================
# Supported providers: anthropic, openai, gemini, zai (or glm)
# For z.ai GLM models:
LLM_PROVIDER=zai
# Available models: glm-4-plus, glm-4-air, glm-4-flash, glm-4-long, glm-zero
LLM_MODEL=glm-4-flash
# Get your API key from https://platform.z.ai/
Z_AI_API_KEY=your_z_ai_api_key_here

# For Google Gemini (alternative):
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-2.0-flash-exp
# GOOGLE_API_KEY=your_actual_gemini_api_key_here

# For Anthropic Claude (default):
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-haiku-4-5-20251001
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# For OpenAI GPT:
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o
# OPENAI_API_KEY=your_openai_api_key_here
# ================================================================
# SYSTEM OF RECORD (workspaces, users, projects)  [Phase 1]
# ================================================================
# SQLite by default so a fresh clone runs with no infrastructure.
# Point this at Postgres/Supabase for anything real:
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/devrelagent
DATABASE_URL=sqlite:///./data/devrelagent.db
DATABASE_ECHO=false
# Create missing tables at startup. Set false in production and run
# `alembic upgrade head` instead.
DATABASE_AUTO_CREATE=true

# ================================================================
# IDENTITY  [Phase 1]
# ================================================================
# "dev" trusts X-Dev-User-Email / X-Dev-User-Name / X-Dev-Workspace headers.
# NEVER use it for anything reachable by untrusted clients.
AUTH_PROVIDER=dev
DEV_USER_EMAIL=dev@localhost
DEV_USER_NAME=Dev User
DEV_WORKSPACE_SLUG=dev-workspace

# For real deployments switch to Clerk (or any OIDC issuer):
# AUTH_PROVIDER=clerk
# CLERK_JWKS_URL=https://<your-clerk-domain>/.well-known/jwks.json
# CLERK_ISSUER=https://<your-clerk-domain>
# CLERK_AUDIENCE=

# Salt used to hash project API keys at rest. Set a long random value in any
# real deployment; changing it invalidates existing keys.
API_KEY_PEPPER=change-me-to-a-long-random-string

# ================================================================
# SHARED SESSION STORE  [Phase 1]
# ================================================================
# "memory" keeps chat sessions in-process (single worker only).
# "redis" shares them across replicas.
SESSION_BACKEND=memory
REDIS_URL=redis://localhost:6379/0
SESSION_TTL_MINUTES=60
