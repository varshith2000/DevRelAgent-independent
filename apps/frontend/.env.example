# Base URL of the DevRelAgent backend API.
# Copy this file to `.env.local` and adjust for your environment.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Static demo build (used by the GitHub Pages workflow).
# NEXT_PUBLIC_DEMO_MODE=true serves checked-in demo fixtures instead of the
# backend API, and turns the build into a static export written to `out/`.
# NEXT_PUBLIC_BASE_PATH must match the hosting sub-path (project pages are
# served from https://<user>.github.io/<repo>/, so use /<repo>).
# NEXT_PUBLIC_DEMO_MODE=true
# NEXT_PUBLIC_BASE_PATH=/DevRelAgent-independent
